# Copy to .env.local. Values for local dev come from `npm run db:start` output.

# Main domain. Streamer pages live on <slug>.<this>.
# Local: localhost:3000 (Chrome/Edge resolve *.localhost automatically)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase (local: shown by `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Sign-in buttons. Leave false until the OAuth apps exist (see supabase/config.toml).
NEXT_PUBLIC_AUTH_DISCORD=false
NEXT_PUBLIC_AUTH_GOOGLE=false

# SlipOK automatic slip checking. Leave empty to use manual approval only.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Optional. If set, /api/cron/keepalive (daily Vercel cron) requires "Authorization: Bearer <this>".
# Vercel sends it automatically when the CRON_SECRET env var exists on the project.
CRON_SECRET=
