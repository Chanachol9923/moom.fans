{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moom",
  "version": "0.1.0",
  "identifier": "fans.moom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moom",
        "width": 980,
        "height": 740,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "Thai",
          "English"
        ],
        "customLanguageFiles": {
          "Thai": "installer/Thai.nsh"
        },
        "displayLanguageSelector": true,
        "startMenuFolder": "Moom"
      }
    },
    "publisher": "Moom",
    "copyright": "© 2026 Moom",
    "category": "Utility",
    "shortDescription": "Moom: alerts, chat and read-aloud for your stream",
    "longDescription": "Plays your Moom tip alerts on this PC, reads messages aloud with the PC's own voices, shows YouTube and Twitch chat in OBS, and talks to VTube Studio."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "moom"
        ]
      }
    }
  }
}
