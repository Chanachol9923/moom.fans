; Thai strings for Tauri's NSIS installer (Tauri doesn't ship Thai).
; Keys match the bundled English.nsh; keep the ${...}, {{...}}, $R4 and $
 placeholders.
LangString addOrReinstall ${LANG_THAI} "เพิ่ม/ติดตั้งส่วนประกอบใหม่"
LangString alreadyInstalled ${LANG_THAI} "ติดตั้งไว้แล้ว"
LangString alreadyInstalledLong ${LANG_THAI} "${PRODUCTNAME} ${VERSION} ติดตั้งอยู่แล้ว เลือกสิ่งที่ต้องการทำ แล้วกด ถัดไป"
LangString appRunning ${LANG_THAI} "{{product_name}} เปิดอยู่ ปิดโปรแกรมก่อนแล้วลองใหม่อีกครั้ง"
LangString appRunningOkKill ${LANG_THAI} "{{product_name}} เปิดอยู่$
กด OK เพื่อปิดโปรแกรม"
LangString chooseMaintenanceOption ${LANG_THAI} "เลือกสิ่งที่ต้องการทำ"
LangString choowHowToInstall ${LANG_THAI} "เลือกวิธีติดตั้ง ${PRODUCTNAME}"
LangString createDesktop ${LANG_THAI} "สร้างทางลัดบนเดสก์ท็อป"
LangString dontUninstall ${LANG_THAI} "ไม่ถอนการติดตั้ง"
LangString dontUninstallDowngrade ${LANG_THAI} "ไม่ถอนการติดตั้ง (ตัวติดตั้งนี้ไม่อนุญาตให้ลดเวอร์ชันโดยไม่ถอนก่อน)"
LangString failedToKillApp ${LANG_THAI} "ปิด {{product_name}} ไม่ได้ ปิดโปรแกรมเองก่อนแล้วลองใหม่อีกครั้ง"
LangString newerVersionInstalled ${LANG_THAI} "มี ${PRODUCTNAME} เวอร์ชันที่ใหม่กว่าติดตั้งอยู่แล้ว ไม่แนะนำให้ติดตั้งเวอร์ชันเก่ากว่า ถ้าต้องการจริงๆ ควรถอนเวอร์ชันปัจจุบันก่อน เลือกสิ่งที่ต้องการทำ แล้วกด ถัดไป"
LangString older ${LANG_THAI} "เก่ากว่า"
LangString olderOrUnknownVersionInstalled ${LANG_THAI} "มี ${PRODUCTNAME} เวอร์ชัน $R4 ติดตั้งอยู่ในเครื่อง แนะนำให้ถอนเวอร์ชันนั้นก่อนติดตั้ง เลือกสิ่งที่ต้องการทำ แล้วกด ถัดไป"
LangString silentDowngrades ${LANG_THAI} "ตัวติดตั้งนี้ไม่อนุญาตให้ลดเวอร์ชันแบบเงียบ ใช้ตัวติดตั้งแบบหน้าต่างแทน$
"
LangString unableToUninstall ${LANG_THAI} "ถอนการติดตั้งไม่ได้"
LangString uninstallApp ${LANG_THAI} "ถอนการติดตั้ง ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_THAI} "ถอนการติดตั้งก่อนติดตั้งใหม่"
LangString unknown ${LANG_THAI} "ไม่ทราบ"
LangString deleteAppData ${LANG_THAI} "ลบข้อมูลของแอปด้วย"
